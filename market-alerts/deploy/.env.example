# On the VPS: copy to /root/ChartSignl/market-alerts/deploy/.env (gitignored).
# Do not put provider API keys or the Postgres password here.
# Those belong in n8n credentials inside this container.
#
# This compose file is not started on the Windows PC. ChartSignl's own n8n
# stays at https://n8n.chartsignl.com. This one is a second container on the
# same server, bound to 127.0.0.1:5679.
#
# Open the editor from your PC with:
#   ssh -L 5679:127.0.0.1:5679 root@167.88.43.61
#   then visit http://localhost:5679
# After DNS for automations.chartsignl.com points at the VPS, switch the
# three values below to that hostname and HTTPS, then reload nginx.

N8N_HOST=localhost
N8N_PROTOCOL=http
N8N_SECURE_COOKIE=false
WEBHOOK_URL=http://localhost:5679/
N8N_ENCRYPTION_KEY=

# Workflow config is read from ../transcripts/.env (also gitignored), not from
# n8n Variables. That file holds TRANSCRIPT_TIMEZONE, TRANSCRIPT_PROVIDER,
# MONTHLY_TRANSCRIPT_LIMIT, SLACK_ALERT_CHANNEL, and HEALTHCHECK_TRANSCRIPTS_URL.
#
# Credentials (nothing from this list goes in the repo):
#   Postgres transcripts_n8n
#   Slack Bot (chat:write, im:write)
#   Supadata API Key — Header Auth, name x-api-key
#   TranscriptAPI Bearer — Header Auth, name Authorization, value "Bearer <key>" (optional)
#   Google Drive OAuth — scope https://www.googleapis.com/auth/drive.file
#     The workflow creates "Trading Transcripts" and does not share it.
